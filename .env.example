# Copy to .env.development; configure production independently.
NODE_ENV=development
APP_NAME=RoadAssist-Server
APP_VERSION=1.0.0
SERVER_PORT=9898
DB_HOST=localhost
DB_PORT=5436
DB_NAME=roadassist_db_dev
DB_USER=roadassist_dev
DB_PASSWORD=replace-with-local-password
DB_FORCE_RESET=false
DB_RESET=false
REDIS_HOST=localhost
REDIS_PORT=6384
REDIS_PASSWORD=replace-with-local-password
ALLOWED_CLIENT_URL_1=http://localhost:5173
ALLOWED_CLIENT_URL_2=http://localhost:8081
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
VIETMAP_API_TOKEN=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RoadAssist Security <noreply@example.com>"
SEPAY_API_URL=https://my.sepay.vn/userapi
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=MBBank
SEPAY_WEBHOOK_TOKEN=
PLATFORM_COMMISSION_RATE=0.10
MAPTILER_API_KEY=
VALHALLA_ROUTER_URL=http://valhalla:8002/route
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SWAGGER_PUBLIC=false

# Email ownership OTP secret; defaults to JWT_SECRET. Login never requires an IP OTP.
AUTH_OTP_SECRET=

# Optional: trusted reverse proxy IPs/CIDRs, comma separated. Leave empty for direct access.
TRUST_PROXY=
# Optional initial administrator. All three identity/credential variables are required to enable seeding.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PHONE=
ADMIN_SEED_NAME=RoadAssist Admin

# Cookie policy: defaults to lax locally and none+Secure in production HTTPS.
# Set lax for deployments where frontend and API are on the same site.
AUTH_COOKIE_SAME_SITE=

# Optional Redis namespace for provider GEO/TTL cache (empty uses roadmap key names).
PROVIDER_REDIS_PREFIX=

# Maximum accuracy radius for a GPS fix to be usable for rescue discovery (1..1000m).
PROVIDER_GPS_MAX_ACCURACY_METERS=100

# Direct S3 uploads, using the same AWS variable names as Picare Core.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=picare-s3
# Optional S3-compatible endpoint / public CDN base URL.
AWS_S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_UPLOAD_TIMEOUT_MS=60000
# Folder is always roadassist/ and visibility always public; controlled server-side.

# Dispatch tariffs in VND; copied into each new ticket. Adjust before deployment.
DISPATCH_SOS_CALLOUT_FEE=30000
DISPATCH_SOS_PER_KM=5000
DISPATCH_TOW_BASE_FEE=150000
DISPATCH_TOW_PER_KM=10000
DISPATCH_WAITING_PER_MINUTE=2000

# SePay webhook security and beneficiary metadata (never use JWT secret here).
SEPAY_WEBHOOK_AUTH=apikey
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NAME=
SEPAY_GATEWAY_NAME=MBBank
SEPAY_SUB_ACCOUNT=
SEPAY_TRANSFER_PREFIX=
PAYMENT_TTL_MINUTES=15
# Preserve the future dispute window before payout eligibility.
PAYOUT_HOLD_DAYS=7

# Operational protection; deadlines are stored per request/assignment.
CASH_DEBT_GRACE_HOURS=24
CASH_MAX_UNPAID_COMPLETED_REQUESTS=2
DISPATCH_QUEUE_TTL_MINUTES=15
DISPATCH_ARRIVAL_TIMEOUT_MINUTES=30
DISPATCH_NO_PROGRESS_MINUTES=10
DISPATCH_MIN_PROGRESS_METERS=100
DISPATCH_MAX_REMATCHES=3
INTAKE_REPLY_MINUTES=5
INTAKE_HOLD_MINUTES=120

# Dispute respondent deadline; filing window remains seven days
DISPUTE_RESPONSE_HOURS=48
